{
  "name": "@fiscaliza/web",
  "version": "0.0.1",
  "description": "Viu um problema? Fiscaliza Aí!",
  "productName": "Fiscaliza Aí!",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "quasar dev -m pwa",
    "build": "quasar build -m pwa",
    "lint": "eslint \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "typecheck": "vue-tsc --noEmit && tsc -p src-pwa/sw/tsconfig.json --noEmit",
    "test": "vitest run",
    "postinstall": "pnpm --dir src-pwa install --frozen-lockfile && quasar prepare --silent"
  },
  "dependencies": {
    "@fiscaliza/contratos": "workspace:*",
    "@fontsource/inter": "^5.3.0",
    "@googlemaps/js-api-loader": "^2.1.3",
    "@googlemaps/markerclusterer": "^2.6.2",
    "@quasar/extras": "^2.1.0",
    "browser-image-compression": "^2.0.2",
    "idb": "^8.0.4",
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.1.0",
    "quasar": "^2.35.4",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@quasar/app-vite": "^3.10.4",
    "@types/google.maps": "^3.66.9",
    "@types/node": "^24.19.2",
    "@vitest/browser-playwright": "^5.0.5",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.32",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14"
  }
}
