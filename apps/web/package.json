{
  "name": "@fiscaliza/web",
  "version": "0.0.1",
  "description": "Viu um problema? Fiscaliza Aí!",
  "productName": "Fiscaliza Aí!",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "quasar dev -m pwa",
    "build": "quasar build -m pwa",
    "lint": "eslint \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "typecheck": "vue-tsc --noEmit && tsc -p src-pwa/sw/tsconfig.json --noEmit",
    "test": "vitest run",
    "postinstall": "pnpm --dir src-pwa install --frozen-lockfile && quasar prepare --silent"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "pinia": "^4.1.0",
    "quasar": "^2.35.2",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@quasar/app-vite": "^3.10.3",
    "@types/node": "^24.19.2",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "postcss": "^8.5.32",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
