# Copie para .env (o .env não é versionado).
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Serviços do docker-compose.yml da raiz (pnpm infra:up)
DATABASE_URL=postgresql://fiscaliza:fiscaliza@localhost:5432/fiscaliza
REDIS_URL=redis://localhost:6379

# Parâmetros provisórios (RN-16), relativo à pasta apps/api
PARAMETROS_CAMINHO=config/parametros.json

# Swagger em /docs. Padrão: ligado fora de produção.
SWAGGER_HABILITADO=true

# Versão exibida no /health (o deploy preenche com o commit)
APP_VERSAO=dev
