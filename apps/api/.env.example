# Copie para .env (o .env não é versionado).
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Serviços do docker-compose.yml da raiz (pnpm infra:up)
DATABASE_URL=postgresql://fiscaliza:fiscaliza@localhost:5432/fiscaliza
REDIS_URL=redis://localhost:6379

# Parâmetros ajustáveis do negócio (score, prazos etc.), relativo à pasta apps/api
PARAMETROS_CAMINHO=config/parametros.json

# Swagger em /docs. Padrão: ligado fora de produção.
SWAGGER_HABILITADO=true

# Versão exibida no /health (o deploy preenche com o commit)
APP_VERSAO=dev

# Endereço do PWA: base dos links dos e-mails (tela /definir-senha) e única origem que o
# CORS deixa chamar a API pelo navegador
WEB_URL=http://localhost:9000

# E-mail transacional. Em desenvolvimento, "arquivo" grava cada e-mail em EMAIL_PASTA
# (abra o .html no navegador). Staging e produção usam "resend", com a chave do GitHub
# Environment; nunca coloque a chave neste arquivo.
EMAIL_TRANSPORTE=arquivo
EMAIL_PASTA=tmp/emails
EMAIL_REMETENTE="Fiscaliza Aí! <nao-responda@fiscalizaai.app>"
# RESEND_API_KEY=

# Login. Sem JWT_SECRET, a API usa um segredo fixo de desenvolvimento; em produção ele é
# obrigatório (staging recebe o do GitHub Environment).
# JWT_SECRET=
# Versão vigente da política de privacidade que o cadastro precisa aceitar.
POLITICA_VERSAO=1
# true só atrás de um proxy (Caddy), para o IP do cliente vir do X-Forwarded-For.
PROXY_CONFIAVEL=false

# Endereço reverso do passo 3 do registro. O servidor público do OpenStreetMap aceita no
# máximo 1 requisição por segundo; a API respeita esse limite e guarda cada endereço por 30 dias.
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Map ID do Google Maps entregue ao PWA no /config/publica. DEMO_MAP_ID é o de testes do Google;
# staging usa a variable GOOGLE_MAPS_MAP_ID do GitHub.
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Storage das fotos. Sem R2_ACCOUNT_ID nem R2_ENDPOINT, a API usa o S3 local do
# docker-compose.yml (http://localhost:9100, credenciais em deploy/local/s3.json). Staging recebe
# a conta e as chaves do R2 do GitHub Environment; nunca coloque as chaves neste arquivo.
R2_BUCKET_UPLOADS=fa-uploads
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
