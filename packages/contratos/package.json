{
  "name": "@fiscaliza/contratos",
  "version": "0.0.1",
  "description": "Tipos TypeScript da API, gerados a partir do OpenAPI. Não edite openapi.json nem src/api.ts à mão.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "gerar": "openapi-typescript openapi.json --output src/api.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3"
  }
}
