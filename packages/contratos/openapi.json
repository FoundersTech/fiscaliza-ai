{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "SaudeController_verificar",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Banco e Redis respondendo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RelatorioSaudeResposta"
                }
              }
            }
          },
          "503": {
            "description": "Banco ou Redis fora do ar.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RelatorioSaudeResposta"
                }
              }
            }
          }
        },
        "tags": [
          "saude"
        ]
      }
    },
    "/api/v1/auth/cadastro": {
      "post": {
        "operationId": "AuthController_cadastrar",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CadastroDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Conta de cidadão criada e logada. O refresh vai no cookie fa_refresh.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessaoResposta"
                }
              }
            }
          },
          "409": {
            "description": "EMAIL_EM_USO"
          },
          "422": {
            "description": "VALIDACAO ou POLITICA_DESATUALIZADA"
          },
          "429": {
            "description": "Mais de 5 tentativas em 3600 s."
          }
        },
        "tags": [
          "autenticacao"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "O refresh vai no cookie fa_refresh.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessaoResposta"
                }
              }
            }
          },
          "401": {
            "description": "CREDENCIAIS_INVALIDAS"
          },
          "429": {
            "description": "Mais de 5 tentativas em 60 s."
          }
        },
        "tags": [
          "autenticacao"
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
        "parameters": [
          {
            "name": "X-FA-CSRF",
            "in": "header",
            "description": "Sempre \"1\". Um site de fora não consegue mandar este header.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Access token novo e cookie novo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessaoResposta"
                }
              }
            }
          },
          "401": {
            "description": "SESSAO_INVALIDA: sem cookie, expirado ou revogado"
          },
          "403": {
            "description": "CSRF_AUSENTE"
          }
        },
        "tags": [
          "autenticacao"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Sessão do aparelho encerrada e cookie apagado."
          }
        },
        "tags": [
          "autenticacao"
        ]
      }
    },
    "/api/v1/auth/esqueci-senha": {
      "post": {
        "operationId": "AuthController_esqueciSenha",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EsqueciSenhaDto"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Sempre 202, exista ou não a conta. Se existir, ela recebe o link de redefinição, que vale por 1 hora."
          },
          "422": {
            "description": "VALIDACAO"
          },
          "429": {
            "description": "Mais de 3 tentativas em 3600 s."
          }
        },
        "tags": [
          "autenticacao"
        ]
      }
    },
    "/api/v1/auth/definir-senha": {
      "post": {
        "operationId": "AuthController_definirSenha",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DefinirSenhaDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Senha definida (redefinição ou convite). Todas as sessões do usuário acabam."
          },
          "400": {
            "description": "TOKEN_INVALIDO: inválido, já usado ou expirado"
          },
          "422": {
            "description": "VALIDACAO"
          }
        },
        "tags": [
          "autenticacao"
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "MeController_perfil",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PerfilResposta"
                }
              }
            }
          },
          "401": {
            "description": "Sem token, ou token inválido ou expirado."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "me"
        ]
      }
    },
    "/api/v1/me/politica": {
      "post": {
        "operationId": "MeController_politica",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AceitePoliticaDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Aceite da versão vigente gravado, com a data."
          },
          "401": {
            "description": "Sem token, ou token inválido ou expirado."
          },
          "422": {
            "description": "POLITICA_DESATUALIZADA ou VALIDACAO"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "me"
        ]
      }
    },
    "/api/v1/config/publica": {
      "get": {
        "operationId": "TerritorioController_configPublica",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigPublicaResposta"
                }
              }
            }
          },
          "503": {
            "description": "MUNICIPIO_NAO_CONFIGURADO"
          }
        },
        "tags": [
          "territorio"
        ]
      }
    },
    "/api/v1/geo/reverso": {
      "get": {
        "operationId": "TerritorioController_geoReverso",
        "parameters": [
          {
            "name": "lat",
            "required": true,
            "in": "query",
            "schema": {
              "minimum": -90,
              "maximum": 90,
              "example": -23.5015,
              "type": "number"
            }
          },
          {
            "name": "lng",
            "required": true,
            "in": "query",
            "schema": {
              "minimum": -180,
              "maximum": 180,
              "example": -47.4526,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeoReversoResposta"
                }
              }
            }
          },
          "401": {
            "description": "Sem token, ou token inválido ou expirado."
          },
          "403": {
            "description": "ACESSO_NEGADO: só para CIDADAO. POLITICA_PENDENTE: falta aceitar a versão vigente da política."
          },
          "422": {
            "description": "VALIDACAO"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "territorio"
        ]
      }
    },
    "/api/v1/uploads/intencao": {
      "post": {
        "operationId": "UploadsController_intencao",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IntencaoUploadDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "URL de envio da foto, válida por 5 minutos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntencaoUploadResposta"
                }
              }
            }
          },
          "401": {
            "description": "Sem token, ou token inválido ou expirado."
          },
          "403": {
            "description": "ACESSO_NEGADO: só para CIDADAO. POLITICA_PENDENTE: falta aceitar a versão vigente da política."
          },
          "422": {
            "description": "FOTO_INVALIDA ou VALIDACAO"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "midia"
        ]
      }
    }
  },
  "info": {
    "title": "Fiscaliza Aí! API",
    "description": "",
    "version": "v1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RelatorioSaudeResposta": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "erro"
            ],
            "description": "ok quando banco e Redis respondem"
          },
          "versao": {
            "type": "string",
            "example": "abc1234",
            "description": "Versão (commit) em execução"
          },
          "db": {
            "type": "string",
            "enum": [
              "ok",
              "erro"
            ]
          },
          "redis": {
            "type": "string",
            "enum": [
              "ok",
              "erro"
            ]
          }
        },
        "required": [
          "status",
          "versao",
          "db",
          "redis"
        ]
      },
      "CadastroDto": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "example": "Maria da Silva",
            "minLength": 2,
            "maxLength": 100
          },
          "apelido_publico": {
            "type": "string",
            "example": "maria.s",
            "minLength": 2,
            "maxLength": 30,
            "description": "Nome que aparece nas ocorrências, se o cidadão quiser"
          },
          "email": {
            "type": "string",
            "example": "maria@exemplo.com",
            "maxLength": 254
          },
          "senha": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "format": "password"
          },
          "politica_versao": {
            "type": "string",
            "example": "1",
            "description": "Versão da política de privacidade aceita"
          }
        },
        "required": [
          "nome",
          "apelido_publico",
          "email",
          "senha",
          "politica_versao"
        ]
      },
      "PerfilResposta": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string"
          },
          "apelido_publico": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "papel": {
            "type": "string",
            "enum": [
              "CIDADAO",
              "AGENTE_ORGAO",
              "ADMIN_MUNICIPIO",
              "ADMIN_PLATAFORMA"
            ]
          },
          "municipio_id": {
            "type": "number",
            "nullable": true
          },
          "orgao_id": {
            "type": "number",
            "nullable": true
          },
          "precisa_aceitar_politica": {
            "type": "boolean",
            "description": "O PWA bloqueia o uso até o aceite da política vigente"
          }
        },
        "required": [
          "id",
          "nome",
          "apelido_publico",
          "email",
          "papel",
          "municipio_id",
          "orgao_id",
          "precisa_aceitar_politica"
        ]
      },
      "SessaoResposta": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "JWT de 15 minutos, enviado no header Authorization: Bearer"
          },
          "usuario": {
            "$ref": "#/components/schemas/PerfilResposta"
          }
        },
        "required": [
          "access_token",
          "usuario"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "maria@exemplo.com"
          },
          "senha": {
            "type": "string",
            "format": "password"
          }
        },
        "required": [
          "email",
          "senha"
        ]
      },
      "EsqueciSenhaDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "maria@exemplo.com",
            "maxLength": 254
          }
        },
        "required": [
          "email"
        ]
      },
      "DefinirSenhaDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "O valor de ?token= do link de redefinição ou de convite"
          },
          "senha": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "format": "password"
          }
        },
        "required": [
          "token",
          "senha"
        ]
      },
      "AceitePoliticaDto": {
        "type": "object",
        "properties": {
          "versao": {
            "type": "string",
            "example": "1",
            "description": "Versão da política de privacidade aceita"
          }
        },
        "required": [
          "versao"
        ]
      },
      "PontoResposta": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lng"
        ]
      },
      "BboxResposta": {
        "type": "object",
        "properties": {
          "sul": {
            "type": "number"
          },
          "oeste": {
            "type": "number"
          },
          "norte": {
            "type": "number"
          },
          "leste": {
            "type": "number"
          }
        },
        "required": [
          "sul",
          "oeste",
          "norte",
          "leste"
        ]
      },
      "MunicipioResposta": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 3552205,
            "description": "Código IBGE"
          },
          "nome": {
            "type": "string",
            "example": "Sorocaba"
          },
          "uf": {
            "type": "string",
            "example": "SP"
          },
          "centro": {
            "description": "Onde o pino começa quando não há GPS",
            "allOf": [
              {
                "$ref": "#/components/schemas/PontoResposta"
              }
            ]
          },
          "bbox": {
            "description": "Retângulo que contém o município",
            "allOf": [
              {
                "$ref": "#/components/schemas/BboxResposta"
              }
            ]
          }
        },
        "required": [
          "id",
          "nome",
          "uf",
          "centro",
          "bbox"
        ]
      },
      "CampoAtributoResposta": {
        "type": "object",
        "properties": {
          "chave": {
            "type": "string",
            "example": "numero_poste"
          },
          "rotulo": {
            "type": "string",
            "example": "Número do poste"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "texto",
              "numero",
              "opcao"
            ]
          },
          "obrigatorio": {
            "type": "boolean"
          },
          "min": {
            "type": "number",
            "description": "Só em numero"
          },
          "max": {
            "type": "number",
            "description": "Tamanho máximo em texto; valor máximo em numero"
          },
          "opcoes": {
            "description": "Só em opcao",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "chave",
          "rotulo",
          "tipo",
          "obrigatorio"
        ]
      },
      "CategoriaResposta": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "slug": {
            "type": "string",
            "example": "iluminacao"
          },
          "nome": {
            "type": "string",
            "example": "Iluminação"
          },
          "icone": {
            "type": "string",
            "example": "lightbulb",
            "description": "Nome de um ícone do Material Icons"
          },
          "schema_atributos": {
            "description": "Campos extras do passo 2",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CampoAtributoResposta"
            }
          }
        },
        "required": [
          "id",
          "slug",
          "nome",
          "icone",
          "schema_atributos"
        ]
      },
      "ConfigPublicaResposta": {
        "type": "object",
        "properties": {
          "municipio": {
            "$ref": "#/components/schemas/MunicipioResposta"
          },
          "categorias_ativas": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoriaResposta"
            }
          },
          "urgente_min_confirmacoes": {
            "type": "number",
            "example": 10,
            "description": "Confirmações para uma ocorrência virar urgente"
          },
          "politica_versao": {
            "type": "string",
            "example": "1",
            "description": "Versão vigente da política de privacidade"
          },
          "google_maps_map_id": {
            "type": "string",
            "example": "DEMO_MAP_ID"
          }
        },
        "required": [
          "municipio",
          "categorias_ativas",
          "urgente_min_confirmacoes",
          "politica_versao",
          "google_maps_map_id"
        ]
      },
      "GeoReversoResposta": {
        "type": "object",
        "properties": {
          "endereco": {
            "type": "string",
            "nullable": true,
            "example": "Rua Quinze de Novembro, 482 · Centro",
            "description": "Null fora da área ou se o geocodificador falhar ou demorar mais de 2 s"
          },
          "dentro_da_area": {
            "type": "boolean",
            "description": "Falso fora de um município atendido: o envio fica bloqueado"
          }
        },
        "required": [
          "endereco",
          "dentro_da_area"
        ]
      },
      "IntencaoUploadDto": {
        "type": "object",
        "properties": {
          "ocorrencia_id": {
            "type": "string",
            "format": "uuid",
            "description": "Id da ocorrência, gerado no aparelho"
          },
          "ordem": {
            "type": "number",
            "enum": [
              1,
              2
            ],
            "description": "Posição da foto na ocorrência"
          },
          "content_type": {
            "type": "string",
            "example": "image/jpeg"
          },
          "bytes": {
            "type": "number",
            "maximum": 307200,
            "description": "Tamanho exato do arquivo: o PUT com outro tamanho é recusado"
          }
        },
        "required": [
          "ocorrencia_id",
          "ordem",
          "content_type",
          "bytes"
        ]
      },
      "IntencaoUploadResposta": {
        "type": "object",
        "properties": {
          "upload_url": {
            "type": "string",
            "description": "PUT com os headers Content-Type e Content-Length do pedido"
          },
          "upload_key": {
            "type": "string",
            "example": "ocorrencias/0b9f3c2e-5d1a-4f6b-9c8e-7a6d5c4b3a21/1-….jpg"
          },
          "expira_em": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "upload_url",
          "upload_key",
          "expira_em"
        ]
      }
    }
  }
}
