            "description": "Banco e Redis respondendo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RelatorioSaudeResposta"
                }
              }
            }
          },
          "503": {
            "description": "Banco ou Redis fora do ar.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RelatorioSaudeResposta"
                }
              }
            }
          }
        },
        "tags": [
          "saude"
        ]
      }
    }
  },
  "info": {
    "title": "Fiscaliza Aí! API",
    "description": "",
    "version": "v1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
